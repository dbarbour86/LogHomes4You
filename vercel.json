{
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.kingscabins.com"
        }
      ],
      "destination": "https://kingscabins.com/$1",
      "permanent": true
    },
    {
      "source": "/about-us",
      "destination": "/about",
      "permanent": true
    },
    {
      "source": "/matthew",
      "destination": "/floor-plans/the-matthew",
      "permanent": true
    }
  ],
  "rewrites": [
    { "source": "/(wp-includes|wp-content|wp-admin|wp-json|wp-login|xmlrpc|cgi-bin)(.*)", "destination": "/404.html" },
    { "source": "/(.*)", "destination": "/index" }
  ]
}
